# Node dependencies & build output
node_modules/
dist/
dist-ssr/
*.local

# Tauri, Rust & Cargo Build Artifacts (Proteksi Anti-Corrupt Index)
target/
src-tauri/target/
**/target/
src-tauri/wix/
*.exe
*.msi
*.dll
*.pdb
*.ilk
*.obj
*.wixobj
*.lib
*.exp

# Sidecar binaries (keep folder structure)
src-tauri/bin/*
!src-tauri/bin/.gitkeep

# Logs, temporary data & Environment files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*
!.env.example

# IDEs and Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini
